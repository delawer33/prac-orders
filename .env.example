# Postgres container bootstrap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5433

# Orders API host port mapping
ORDERS_HOST_PORT=8001

# Orders service database DSN
postgres_url=postgresql+asyncpg://postgres:your_password_here@orders_postgres:5432/postgres

# Users service endpoint
users_service_url=http://users_app:8000
users_service_api_prefix=/v1/users

# Users client timeout and retries
users_service_http_timeout_seconds=5.0
users_service_retry_attempts=3
users_service_retry_wait_initial_seconds=0.5
users_service_retry_wait_exp_base=2.0
users_service_retry_wait_max_seconds=10.0

# Users circuit breaker
users_service_cb_fail_max=5
users_service_cb_timeout_seconds=30
users_service_cb_name=users-service

# Compensation worker tuning
saga_worker_poll_interval_seconds=5
saga_worker_batch_size=20
saga_recovery_grace_seconds=30

# Local app runtime
app_host=localhost
app_port=8001
app_reload=true
